# Data files: never commit (Kaggle terms, and application_train.csv is 166 MB)
data/
*.csv
*.zip
*.parquet
*.feather
*.pkl
*.joblib

# Learned parameters and intermediate outputs are regenerated by data_preparation.py
prep_params.json

# Python and notebook clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Quarto render artifacts (the rendered HTML is submitted on Canvas, not committed)
notebooks/*_files/
notebooks/*.html
notebooks/*.quarto_ipynb
.quarto/

# Model outputs: Kaggle submissions and saved models
submissions/
models/

# OS files
.DS_Store
Thumbs.db
